# init.ps1 creates random credentials. Do not commit the resulting .env.
MYSQL_PASSWORD=replace-with-random-hex
MYSQL_ROOT_PASSWORD=replace-with-different-random-hex
HAI_INVITE_CODE=replace-with-private-invite
HAI_DEMO_MODE=false
HAI_BIND=127.0.0.1
HAI_HTTPS_PORT=9443
HAI_ALLOWED_ORIGINS=https://localhost:9443


# Emergency stop: restart API and workers after changing.
HAI_AI_STOPPED=false

# Optional local NVIDIA GPU inference (downloads model weights separately).
# COMPOSE_PROFILES=local-ai
